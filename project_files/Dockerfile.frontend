FROM python:3.14-slim
 
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
 
WORKDIR /app
 
# The UI only needs these two packages (versions match requirements.txt).
RUN pip install streamlit==1.65.0 requests==2.34.2
RUN python -c "import streamlit, requests; print('deps OK')"
 
COPY frontend.py .
 
EXPOSE 8501
 
CMD ["streamlit", "run", "frontend.py", "--server.address=0.0.0.0", "--server.port=8501"]